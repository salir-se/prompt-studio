{
  "name": "@salir-se/prompt-studio-workspace",
  "version": "1.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:npm-package": "bun scripts/build-npm-package.ts",
    "smoke:npm-package": "bun scripts/smoke-npm-package.ts",
    "test": "vitest run",
    "lint": "bun scripts/bun-lint.ts . && bun fmt --check .",
    "test:e2e": "playwright test",
    "ps": "bun cli/main.ts",
    "lint:fix": "bun scripts/bun-lint.ts --fix . && bun fmt .",
    "typecheck": "bun check -p tsconfig.json",
    "test:packages": "vitest run --config vitest.packages.config.ts --coverage.enabled=false",
    "ci": "bun run lint && bun run typecheck && bun run check:public-content && bun run test && bun run test:packages && bun run build",
    "check:public-content": "bun scripts/check-public-content.ts"
  },
  "dependencies": {
    "@radix-ui/react-focus-scope": "1.1.7",
    "@headless-tree/core": "1.8.0",
    "@headless-tree/react": "1.8.0",
    "@prompt-studio/agent": "workspace:*",
    "@prompt-studio/help-system": "workspace:*",
    "@prompt-studio/prompt-graph-ui": "workspace:*",
    "@prompt-studio/prompts": "workspace:*",
    "@prompt-studio/ui": "workspace:*",
    "arktype": "^2.2.0",
    "fflate": "^0.8.3",
    "isomorphic-git": "^1.40.0",
    "memfs": "^4.64.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.0",
    "@prompt-studio/observability": "workspace:*",
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "fake-indexeddb": "^6.2.2",
    "happy-dom": "^20.8.9",
    "path-browserify": "^1.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "readable-stream": "^4.7.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.2.2",
    "vite": "^8.0.3",
    "vitest": "5.0.5",
    "shadcn": "^4.1.2",
    "tw-animate-css": "^1.4.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@types/node": "^24.10.1"
  },
  "description": "Prompt Studio: a local editor for prompt projects with versions, evaluations, and GitHub pull requests.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salir-se/prompt-studio.git"
  },
  "homepage": "https://github.com/salir-se/prompt-studio#readme",
  "bugs": {
    "url": "https://github.com/salir-se/prompt-studio/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.4.4",
    "node": ">=22"
  }
}
